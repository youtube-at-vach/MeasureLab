{
    "config": {
        "default": true,
        "MD013": false, // Line length - usually too strict for docs with long URLs
        "MD024": false, // Duplicate headings - useful for "Parameters" sections etc
        "MD033": false, // Inline HTML - needed for some advanced formatting
        "MD034": false, // Bare URL used - sometimes intentional
        "MD041": false, // First line must be h1 - mkdocs often uses frontmatter title
        "MD029": false, // Ordered list item prefix - acceptable to have different styles
        "MD004": false, // Unordered list style - allow mixed * and -
        "MD030": false, // Spaces after list markers - allow 2 or 3 spaces
        "MD022": false, // Headings should be surrounded by blank lines - strict for existing docs
        "MD031": false, // Fenced code blocks should be surrounded by blank lines
        "MD032": false, // Lists should be surrounded by blank lines
        "MD007": false, // Unordered list indentation - allow mixed 2 or 4 spaces
        "MD009": false // Trailing spaces - ignore invisible whitespace
    },
    "ignores": [
        "site/",
        ".git/",
        "node_modules/",
        ".venv/"
    ]
}